POSTGRES_USER=meetings
POSTGRES_PASSWORD=meetings
POSTGRES_DB=meetings
# Host port for Postgres (change if 5432 is already in use)
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://meetings:meetings@db:5432/meetings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth (Cognito, created by Terraform: infra/auth.tf) ---
# Copy these from `make infra-output` (user_pool_id, user_pool_client_id, cognito_domain,
# google_enabled); they are public IDs, not secrets. Local runs use the same user pool as AWS.
# The backend only accepts ID tokens from this pool and app client.
# Google sign-in: google_client_id is in infra/terraform.tfvars and google_client_secret is a
# sensitive variable of the HCP Terraform workspace. Never put the secret in a file.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_GOOGLE_ENABLED=false

# --- AWS deployment (make deploy-backend, make deploy-frontend) ---
# Credentials of an IAM user allowed to manage CloudFormation, Lambda, EC2/VPC, RDS, ECR,
# IAM roles, SSM Parameter Store, S3, CloudFront, CloudWatch Logs, and for a custom domain
# ACM and Route 53. Never commit real values. Cognito, the reports and the agenda parser are
# not deployed with these keys: HCP Terraform applies them, with its own short-lived role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary (STS) credentials
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# Prefix for all AWS resource and stack names; every resource is tagged PROJECT_NAME=<this>
PROJECT_NAME=new-project
# Extra origins allowed to call the deployed API, comma-separated. The CloudFront address
# and the custom domain are added automatically.
CORS_ORIGINS_AWS=
# Backend Lambda memory in MB (CPU scales with it; 400,000 GB-seconds/month are free)
LAMBDA_MEMORY=512

# --- Custom domain (make add-domain, after make deploy) ---
# Host name for the frontend, e.g. app.example.com. Leave empty for the *.cloudfront.net address.
DOMAIN_NAME=
# Optional Route 53 hosted zone id of DOMAIN_NAME (e.g. Z0123456789ABC). If set, the DNS records
# are created for you; otherwise make add-domain prints the records to add at your DNS provider.
HOSTED_ZONE_ID=

# --- Paste an agenda (Lab 6) ---
# Model for `make parse` / `make llm-hello` from the laptop. The deployed parser uses
# parser_model from infra/terraform.tfvars. Amazon Nova (Converse API) while Anthropic models are
# not enabled on the account; anthropic.claude-opus-5-5 for Claude (Messages API).
# `make llm-models` lists what is enabled.
PARSER_MODEL=us.amazon.nova-lite-v1:0
